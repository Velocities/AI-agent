# Ollama LLM backend (local or remote; independent of command execution)
# Examples: http://localhost:11434  or  http://home-server:11434
# For the two-window workflow, ai-agent-llm prints a URL to paste here.
OLLAMA_HOST=http://localhost:11434
# Real Ollama used by `ai-agent-llm` (do not point this at the facade URL)
OLLAMA_UPSTREAM=http://localhost:11434
# LLM_BIND_HOST=127.0.0.1
# LLM_BIND_PORT=0
# Remote inference: run `ai-agent config remote-provider` (writes these)
# OLLAMA_TRANSPORT=http
# OLLAMA_SSH_HOST=
# OLLAMA_SSH_CONFIG=.ai-agent/ssh/config
# OLLAMA_SSH_REMOTE=127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
# OLLAMA_TIMEOUT=600
# Context window. Ollama defaults to 4096, which truncates long answers.
OLLAMA_NUM_CTX=16384
# Optional output cap only; leave unset so the model is not cut off mid-answer.
# OLLAMA_NUM_PREDICT=8192

# Agent behavior
AGENT_LOG_LEVEL=INFO
AGENT_STREAM_RESPONSES=true
AGENT_MAX_ITERATIONS=15
AGENT_MAX_CONTINUATIONS=8
AGENT_CONTINUATION_TAIL=2000
AGENT_TOOL_TIMEOUT=60
AGENT_CONFIRMATION_MODE=balanced
AGENT_OUTPUT_LIMIT=32768

# Audit log path (JSON lines). Leave empty for stderr-only audit events.
AGENT_AUDIT_LOG=

# Optional override for policy rules file (default policy + Windows overlay apply automatically)
AGENT_POLICY_FILE=

# Scratch directory for limited redirect targets (must exist and be writable by ai user)
AGENT_SCRATCH_DIR=/tmp/ai-agent

# Where approved commands run (independent of OLLAMA_HOST)
# AGENT_EXECUTION_TARGETS_FILE=execution_targets.yaml
# AGENT_DEFAULT_TARGET=local
