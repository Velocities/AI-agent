# --- LLM: see README Setup guide (Path A–E) ---
# Agent client URL (facade, direct Ollama/vLLM, or SSH tunnel local end).
# Path B: ai-agent-llm prints LLM_HOST to paste here.
LLM_HOST=http://localhost:11434
# Engine bind URL for ai-agent-llm only — NOT the facade URL.
LLM_UPSTREAM=http://localhost:11434
# ai-agent-llm starts/stops the engine here by default.
# LLM_MANAGE_UPSTREAM=true
# LLM_STARTUP_TIMEOUT=180
# LLM_OLLAMA_BINARY=
# LLM_VLLM_BINARY=
# Server-side engine: ollama | vllm
# LLM_ENGINE=ollama
# LLM_BIND_HOST=127.0.0.1
# LLM_BIND_PORT=0
# Remote inference: run `ai-agent config remote-provider` (writes these)
# LLM_TRANSPORT=http
# LLM_SSH_HOST=
# LLM_SSH_CONFIG=.ai-agent/ssh/config
# LLM_SSH_REMOTE=127.0.0.1:11434
LLM_MODEL=qwen3:14b
# LLM_TIMEOUT=600
# Ollama engine only:
# OLLAMA_NUM_CTX=16384
# OLLAMA_NUM_PREDICT=8192
# vLLM engine only:
# VLLM_MAX_TOKENS=4096

# Agent behavior
AGENT_LOG_LEVEL=INFO
AGENT_STREAM_RESPONSES=true
AGENT_MAX_ITERATIONS=15
AGENT_MAX_CONTINUATIONS=8
AGENT_CONTINUATION_TAIL=2000
AGENT_TOOL_TIMEOUT=60
AGENT_CONFIRMATION_MODE=balanced
AGENT_OUTPUT_LIMIT=32768

# Audit log path (JSON lines). Leave empty for stderr-only audit events.
AGENT_AUDIT_LOG=

# Optional override for policy rules file (default policy + Windows overlay apply automatically)
AGENT_POLICY_FILE=

# Scratch directory for limited redirect targets (must exist and be writable by ai user)
AGENT_SCRATCH_DIR=/tmp/ai-agent

# Where approved commands run (independent of LLM_HOST)
# AGENT_EXECUTION_TARGETS_FILE=execution_targets.yaml
# AGENT_DEFAULT_TARGET=local
