## Copy to local.properties (never commit local.properties).
## Android Studio will also add sdk.dir when you open this project.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

## HTTPS origin of ai-agent-serve. Example: https://agent.example.com
# API_BASE_URL=

## Developer debug flags. Each defaults to false in every build type and can
## also be set per build with Gradle, e.g. ./gradlew -PAUTH_DEBUG=true :app:assembleDebug
## AUTH_DEBUG: session/profile panel on the sign-in screen and under Account → Auth debug.
# AUTH_DEBUG=true
