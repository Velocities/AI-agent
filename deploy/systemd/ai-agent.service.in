# Generated by deploy/systemd/install.sh. Do not edit the copy in /etc by hand;
# re-run the installer after moving the checkout or recreating the virtualenv.
#
# One process (`ai-agent serve`) starts the inference engine, the local LLM
# facade, and the loopback API. systemd is the process manager.
#
# Configuration is the .env file in WorkingDirectory. The process loads it.
# Do not point EnvironmentFile at that same file.
#
# TimeoutStartSec covers engine startup plus model warmup. Raise it together
# with LLM_STARTUP_TIMEOUT if a large model needs longer. The service reports
# ready only after the API socket is listening.
#
# PrivateTmp stays off so AGENT_SCRATCH_DIR=/tmp/ai-agent is the real directory.
# PrivateDevices stays off so GPU device nodes remain visible.
# MemoryDenyWriteExecute and a syscall filter are omitted; Python and CUDA need them.

[Unit]
Description=AI agent (model and API)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@WORKING_DIRECTORY@
ExecStart=@EXEC_START@ serve
Environment="PATH=@PATH@"
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=40
KillMode=mixed
KillSignal=SIGTERM
StateDirectory=ai-agent
StateDirectoryMode=0750
UMask=0077
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-agent
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=@PROTECT_HOME@
PrivateTmp=false
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
