# Generated by deploy/systemd/install.sh. Do not edit the copy in /etc by hand.
#
# This process is the only one that opens the Docker socket. The API service
# connects to its Unix socket and sends intents. The API user is not in the
# docker group.

[Unit]
Description=AI agent Docker broker
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=@BROKER_USER@
Group=@SERVICE_GROUP@
SupplementaryGroups=docker
WorkingDirectory=@WORKING_DIRECTORY@
ExecStart=@BROKER_BIN@ --socket /run/ai-agent/docker.sock --api-user @SERVICE_USER@ --sandbox-root @WORKING_DIRECTORY@/sandbox
StateDirectory=ai-docker
StateDirectoryMode=0750
Environment=HOME=/var/lib/ai-docker
Environment=DOCKER_CONFIG=/var/lib/ai-docker/.docker
Environment=AI_AGENT_DOCKER_BROKER_STATE=/var/lib/ai-docker
RuntimeDirectory=ai-agent
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
